generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Identity & Auth ----

model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  username      String   @unique
  passwordHash  String?
  guest         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens RefreshToken[]
  player        Player?
  gachaHistory  GachaHistory[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---- Player ----

model Player {
  id              String   @id @default(cuid())
  userId          String   @unique
  name             String   @default("Hunter")
  level            Int      @default(1)
  exp              Int      @default(0)
  gold             Int      @default(1000)
  gems             Int      @default(50)
  stamina          Int      @default(100)
  staminaMax       Int      @default(100)
  staminaRegenAt   DateTime @default(now())
  tutorialStep     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User          @relation(fields: [userId], references: [id])
  familiarInstances FamiliarInstance[]
  formations       Formation[]
  playerProgress   PlayerProgress[]
  pityCounter      PityCounter?
  currencies       Currency[]
  inventory        Inventory[]
  battles          Battle[]
  gachaHistory     GachaHistory[]

  @@map("players")
}

// ---- Familiar Definitions ----

model Character {
  id              String   @id @default(cuid())
  charId          String   @unique // e.g., "iron_warden"
  name            String
  warlord         Warlord
  rarity          Rarity
  race            String   // Human / Beast / Machine / Alien / Mutant / etc.
  gender          String   // M / F / Unknown / None
  evolution       Int      @default(0) // 0=base, 1=evolved, 2=final
  baseHp          Int
  baseAtk         Int
  baseDef         Int
  baseWis         Int
  baseAgi         Int
  totalExp        Int      @default(0) // cumulative EXP needed for max level
  growthId        String?  // growth curve reference
  skillId         String?
  passiveId       String?  // passive skill
  evolutionLineId String?
  createdAt       DateTime @default(now())

  skill           Skill?        @relation(fields: [skillId], references: [id])
  passive         Passive?      @relation(fields: [passiveId], references: [id])
  growth          Growth?       @relation(fields: [growthId], references: [id])
  evolutionLine   EvolutionLine? @relation(fields: [evolutionLineId], references: [id])
  instances       CharacterInstance[]
  gachaItems      GachaItem[]

  @@map("characters")
}

model CharacterInstance {
  id              String   @id @default(cuid())
  playerId        String
  characterId     String
  level           Int      @default(1)
  exp             Int      @default(0)
  star            Int      @default(1) // 1-5
  skillLevel      Int      @default(1)
  isInFormation   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  character       Character @relation(fields: [characterId], references: [id])

  @@index([playerId])
  @@map("character_instances")
}

model Skill {
  id          String    @id @default(cuid())
  skillId     String    @unique
  name        String
  description String
  effects     Json      // skill effects config
  createdAt   DateTime  @default(now())

  characters  Character[]

  @@map("skills")
}

model Passive {
  id          String    @id @default(cuid())
  passiveId   String    @unique
  name        String
  description String
  effects     Json
  createdAt   DateTime  @default(now())

  characters  Character[]

  @@map("passives")
}

model Growth {
  id              String    @id @default(cuid())
  growthId        String    @unique
  name            String
  expCurve        Json      // level thresholds
  statMultipliers Json      // per-level multipliers
  createdAt       DateTime  @default(now())

  characters      Character[]

  @@map("growth_curves")
}

model EvolutionLine {
  id              String    @id @default(cuid())
  name            String
  stages          Json      // evolution requirements per stage
  createdAt       DateTime  @default(now())

  characters      Character[]

  @@map("evolution_lines")
}

// ---- Formation ----

model Formation {
  id        String   @id @default(cuid())
  playerId  String
  name      String   @default("Formation 1")
  slot1     String?  // FamiliarInstance ID
  slot2     String?
  slot3     String?
  slot4     String?
  slot5     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("formations")
}

// ---- Gacha ----

model GachaPool {
  id          String   @id @default(cuid())
  name        String   @default("Standard")
  description String?
  active      Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime?

  items       GachaItem[]

  @@map("gacha_pools")
}

model GachaItem {
  id        String   @id @default(cuid())
  poolId    String
  familiarId String
  characterId String
  guaranteedSr Boolean @default(false)

  pool      GachaPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id])

  @@map("gacha_items")
}

model GachaHistory {
  id          String   @id @default(cuid())
  playerId    String
  userId      String
  poolId      String
  characterId String
  rarity      Rarity
  pityCount   Int      @default(0)
  isPity      Boolean  @default(false)
  createdAt   DateTime @default(now())

  player      Player   @relation(fields: [playerId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([playerId])
  @@map("gacha_history")
}

model PityCounter {
  id              String   @id @default(cuid())
  playerId        String   @unique
  poolId          String
  count           Int      @default(0)
  guaranteedSr    Int      @default(10)
  guaranteedSsr   Int      @default(100)
  lastPullAt      DateTime @default(now())

  player          Player   @relation(fields: [playerId], references: [id])

  @@map("pity_counters")
}

// ---- Battle ----

model Battle {
  id              String   @id @default(cuid())
  battleId        String   @unique // e.g., "B-001928"
  playerId        String
  stageId         String?
  seed            Int
  engineVersion   String   @default("0.1.0")
  status          BattleStatus @default(ONGOING)
  result          BattleResult?
  turnCount       Int      @default(0)
  durationMs      Int      @default(0)
  rewards         Json?
  log             Json?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  player          Player   @relation(fields: [playerId], references: [id])

  @@index([playerId])
  @@map("battles")
}

// ---- PvE ----

model Stage {
  id          String   @id @default(cuid())
  stageId     String   @unique
  chapter     Int
  number      Int
  name        String
  staminaCost Int      @default(6)
  enemies     Json     // enemy formation config
  rewards     Json     // first clear rewards
  createdAt   DateTime @default(now())

  progress    PlayerProgress[]

  @@map("stages")
}

model PlayerProgress {
  id            String   @id @default(cuid())
  playerId      String
  stageId       String
  cleared       Boolean  @default(false)
  stars         Int      @default(0)
  bestTimeMs    Int?
  firstClearAt  DateTime?
  attempts      Int      @default(0)
  updatedAt     DateTime @updatedAt

  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  stage         Stage    @relation(fields: [stageId], references: [id])

  @@unique([playerId, stageId])
  @@index([playerId])
  @@map("player_progress")
}

// ---- Inventory ----

model Currency {
  id        String   @id @default(cuid())
  playerId  String
  type      String   // "gold", "gems", "stamina"
  amount    Int      @default(0)
  updatedAt DateTime @updatedAt

  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, type])
  @@index([playerId])
  @@map("currencies")
}

model Inventory {
  id        String   @id @default(cuid())
  playerId  String
  itemType  String   // "equipment", "material", "consumable"
  itemId    String
  quantity  Int      @default(1)
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, itemType, itemId])
  @@index([playerId])
  @@map("inventory")
}

// ---- Enums ----

enum Warlord {
  TRANSCENDENT
  PURIST
  WILD
  UNKNOWN
  CYBERIST
}

enum Rarity {
  N
  R
  SR
  SSR
}

enum BattleStatus {
  ONGOING
  VICTORY
  DEFEAT
  ABANDONED
}

enum BattleResult {
  VICTORY
  DEFEAT
  DRAW
}
